# ---------------------------------------------------------------------------
# Example configuration. Copy to .env and fill in the first block.
#
# Only the REQUIRED values have no default. Everything else is safe to leave
# commented out; the defaults in src/config.js are used instead.
# ---------------------------------------------------------------------------

# === required ==============================================================

# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# Nothing else needs the token; it is never logged.
DISCORD_TOKEN=

# The one guild to collect. Right-click the server → Copy Server ID.
DISCORD_GUILD_ID=

# === storage ===============================================================

# Where the SQLite file lives. DOCKER USERS: leave this alone and set DATA_DIR
# instead — the container writes to /data, which is a mounted volume, and both
# compose files set DATA_DIR=/data explicitly.
#
# Relative paths resolve against the working directory of the node process, which is
# app/ when you run `npm start` (the Node project lives there). The repo's data/
# directory is one level up, hence ../data. Under systemd, prefer an absolute path.
# DB_PATH=/srv/metrics/metrics.db
DATA_DIR=../data

# How long a writer waits on a locked database before erroring with SQLITE_BUSY.
# The API reads while the collector writes, so a few seconds of patience is what
# keeps a flush from surfacing to the model as an error.
# DB_BUSY_TIMEOUT_MS=5000

# === collection ============================================================

# How often in-memory counters are written to disk. Lower = less lost on a hard
# kill, more write pressure. Anything from 5000 to 60000 is reasonable.
# FLUSH_INTERVAL_MS=15000

# Presence snapshot cadence (online count, boost count, member count).
# SNAPSHOT_INTERVAL_MINUTES=10

# A presence row older than this makes /v1/presence report stale instead of
# pretending the last known value is current.
# PRESENCE_STALE_MINUTES=30

# Retention sweep cadence. VACUUM runs on the same timer.
# MAINTENANCE_INTERVAL_MINUTES=60

# Rows kept at hourly resolution. Daily rollups are kept separately, so lowering
# this does not lose long-range history — it only stops per-hour drill-down.
# RETENTION_HOURLY_DAYS=90

# Rows kept at daily resolution. Two years of daily aggregates is a few MB.
# RETENTION_DAILY_DAYS=730

# API request audit log retention.
# AUDIT_RETENTION_DAYS=30

# How long to wait for the gateway READY event before failing fast instead of
# sitting in a loop that looks alive but collects nothing.
# READY_TIMEOUT_SECONDS=60

# === what gets measured ====================================================

# Per-channel breakdowns cost one row per channel per bucket. Turn off for a
# single-total database.
# PER_CHANNEL_METRICS=true

# off | hmac. Per-member counters (needed for the engagement endpoint).
#   off  = no per-member rows at all (default, most private)
#   hmac = HMAC-SHA256(user_id, HMAC_KEY); stable, opaque, reversible only with
#          the key. Required for /v1/engagement to return data.
# PER_MEMBER_COUNTERS=off

# Required when PER_MEMBER_COUNTERS=hmac. Generate with:
#   head -c 32 /dev/urandom | base64
# Losing this key invalidates existing pseudonyms; changing it starts a new set.
# HMAC_KEY=

# Roles whose messages are ignored entirely (staff bots, announcement relay).
# Comma-separated role IDs.
# EXCLUDED_ROLE_IDS=

# The anonymity floor k for any published cross-tab of people: cohort retention,
# core churn, engagement volume bands. A count of people below k is withheld, and
# so is a count whose complement is below k ("19 of 20 came back" names the one who
# did not). A second cell is withheld when one withheld cell could be recovered by
# subtracting the published cells from a total. Raise it for a small or sensitive
# server; 2 is accepted but protects almost nothing.
# PRIVACY_MIN_CELL=10

# === analytics windows =====================================================

# Length of the baseline window an event's uplift is measured against. The baseline
# is matched by UTC weekday, so this must be long enough to contain several of each
# weekday the event touches: 28 days gives four.
# EVENT_BASELINE_DAYS=28

# Minimum number of baseline days with activity before uplift is quoted at all.
# Below this the ratio is refused (baseline_too_short) rather than qualified: a
# week of history does not survive a second look.
# EVENT_BASELINE_NOISY_DAYS=14

# Minimum baseline days per weekday before a weekday-matched baseline is trusted.
# 28 baseline days gives 4 per weekday; 3 is the smallest defensible mean.
# EVENT_MATCHED_MIN_DAYS=3

# Refuse a message uplift when the event window itself has fewer messages than
# this: a ratio derived from a handful of messages is noise with a decimal point.
# EVENT_UPLIFT_MIN_MESSAGES=30

# === core and channel lifecycle ============================================

# Fraction of active members that counts as the core, between 0.02 and 0.5.
# CORE_SHARE=0.2

# How many complete periods (/v1/core) the trend looks back over.
# CORE_PERIODS=8

# A channel with no message or voice for this many days is dormant. It must have
# been active at some point first: a channel created last week is not dormant.
# CHANNEL_DORMANT_DAYS=21

# Messages a channel needs in the window before a growing/declining call is made.
# Below this it is reported as low_volume, not as a decline.
# CHANNEL_MIN_MESSAGES=20

# === HTTP API ==============================================================

# Loopback only. The server refuses to bind anywhere else unless
# ALLOW_PUBLIC_BIND=true, and refuses routable public addresses even then.
# API_HOST=127.0.0.1
# API_PORT=8283

# Token file written by `npm run token`. Keep it out of git (it is gitignored)
# and back it up with the database.
# TOKENS_FILE=./data/tokens.json

# Per-token sliding-window rate limit, requests per minute.
# RATE_LIMIT_PER_MIN=60

# Extra network allowlist on top of the token check: exact IPs or IPv4/IPv6
# CIDRs, comma separated. Useful when the API is reachable from a LAN or a
# container network rather than just localhost.
# API_ALLOWED_IPS=127.0.0.1,::1

# Hard cap on ?top=. Raising it is allowed but pointless unless the consumer
# actually charts more than ten series.
# API_MAX_TOP=10

# Responses larger than this are replaced with a 500 and a log line, rather than
# handing a model a payload it will truncate anyway.
# API_MAX_RESPONSE_KB=256

# Request audit rows are buffered and batch-inserted.
# AUDIT_FLUSH_SECONDS=10
# AUDIT_BUFFER_ROWS=500

# Set true only if you have a reason to bind beyond loopback. There is no
# built-in TLS; put a reverse proxy in front if the network is untrusted.
# ALLOW_PUBLIC_BIND=false

# === process ===============================================================

# debug | info | warn | error
# LOG_LEVEL=info

# Fallback zone for `npm run tag` when --tz is omitted. A mis-stored hour is the
# one mistake tagging cannot detect afterwards, so set this if your events are
# announced in local time.
# TAG_TZ=America/New_York
